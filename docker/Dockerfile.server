# syntax=docker/dockerfile:1.7
FROM golang:1.26.5-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY migrations ./migrations
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_TIME=unknown
ARG TARGETOS=linux
ARG TARGETARCH
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" go build -trimpath -tags "netgo,osusergo" \
    -ldflags="-s -w -X github.com/portpilot/portpilot/internal/version.Version=${VERSION} -X github.com/portpilot/portpilot/internal/version.Commit=${COMMIT} -X github.com/portpilot/portpilot/internal/version.BuildTime=${BUILD_TIME}" \
    -o /out/portpilot-server ./cmd/portpilot-server

FROM alpine:3.23
WORKDIR /var/lib/portpilot
COPY --from=builder /out/portpilot-server /usr/local/bin/portpilot-server
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
RUN /usr/local/bin/portpilot-server version
ENTRYPOINT ["/usr/local/bin/portpilot-server"]
CMD ["run", "--config", "/etc/portpilot/server.json"]
